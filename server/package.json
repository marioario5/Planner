{
  "name": "cozy-planner-server",
  "private": true,
  "type": "module",
  "description": "MCP + REST backend for the cozy planner (Cloudflare Worker + D1)",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "db:init:local": "wrangler d1 execute cozy-planner --local --file=schema.sql",
    "db:init:remote": "wrangler d1 execute cozy-planner --remote --file=schema.sql",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "db:sync:local": "wrangler d1 execute cozy-planner --local --file=migrations/0004_site_sync.sql",
    "db:sync:remote": "wrangler d1 execute cozy-planner --remote --file=migrations/0004_site_sync.sql",
    "db:info:local": "wrangler d1 execute cozy-planner --local --file=migrations/0003_day_info.sql",
    "db:info:remote": "wrangler d1 execute cozy-planner --remote --file=migrations/0003_day_info.sql",
    "db:migrate:local": "wrangler d1 execute cozy-planner --local --file=migrations/0002_time_and_notes.sql",
    "db:migrate:remote": "wrangler d1 execute cozy-planner --remote --file=migrations/0002_time_and_notes.sql"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261002.1",
    "typescript": "^7.0.2",
    "vitest": "^5.0.3",
    "wrangler": "^4.146.0"
  }
}
